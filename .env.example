# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/poultry_farm?retryWrites=true&w=majority

# Admin Credentials & JWT Auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_SECRET_KEY=your_secure_jwt_secret_key_min_32_chars

# Vercel Blob Storage Credentials
BLOB_STORE_ID=store_your_blob_store_id
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here
